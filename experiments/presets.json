{
  "version": 1,
  "presets": [
    {
      "name": "weights_percentile (P60, bg=0)",
      "spec_id": "compute_weights",
      "params": {
        "base_run": "baseline",
        "output_dir": "weights_percentile",
        "weight_formula": "autoopt",
        "background_mask_value": 0.0,
        "fold_start": 1,
        "fold_end": 5,
        "read_only_reward_dir": ""
      }
    },
    {
      "name": "weights_new_formula (density-gap, bg=0)",
      "spec_id": "compute_density_gap_weights",
      "params": {
        "base_run": "baseline",
        "output_dir": "weights_new_formula",
        "weight_formula": "density_gap",
        "background_mask_value": 0.0,
        "fold_start": 1,
        "fold_end": 5,
        "read_only_reward_dir": ""
      }
    },
    {
      "name": "train reward_percentile_dark",
      "spec_id": "cv_train",
      "params": {
        "run_name": "reward_percentile_dark",
        "weights_dir": "weights_percentile",
        "k": 5,
        "epochs": 30,
        "batch_size": 32,
        "seed": 42,
        "fold_start": 1,
        "fold_end": 5
      }
    },
    {
      "name": "overlap — baseline vs reward vs log vs exp",
      "spec_id": "overlap",
