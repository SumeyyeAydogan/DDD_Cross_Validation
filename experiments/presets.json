        "baseline_label": "baseline",
        "background_mask_value": 0.0,
        "experiment_id": "density_gap_new_formula",
        "focus_metric": "density_gap"
      }
    },
    {
      "name": "model comparison — inside density only",
      "spec_id": "model_comparison",
      "params": {
        "output_tag": "inside_density_only",
        "fold_start": 1,
        "fold_count": 5,
        "baseline_label": "baseline",
        "background_mask_value": 0.0,
        "experiment_id": "inside_density_only",
        "focus_metric": "inside_density"
      }
